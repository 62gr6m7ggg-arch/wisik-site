{
  "name": "wisik-site",
  "version": "0.1.32",
  "private": true,
  "description": "Wisik.nl — festivalterrein voor rekenen en wiskunde",
  "scripts": {
    "seo:build": "node scripts/build-site-seo.mjs --write",
    "seo:check": "node scripts/test-site-seo.mjs && node scripts/build-site-seo.mjs --check",
    "audit:update": "node scripts/audit-pabo-release.mjs --write",
    "audit:verify": "node scripts/audit-pabo-release.mjs",
    "pabo:didactic": "node scripts/pabo-didactic-audit.mjs",
    "check": "node scripts/release-prepare.mjs",
    "build": "node scripts/release-prepare.mjs",
    "preview": "npx wrangler pages dev public",
    "deploy": "npx wrangler pages deploy public --project-name wisik-site",
    "pabo:variation": "node scripts/test-pabo-variation.mjs",
    "pabo:variation:build": "node scripts/apply-pabo-variation.mjs",
    "pabo:reasoning": "node scripts/test-pabo-reasoning.mjs",
    "pabo:reasoning:build": "node scripts/apply-pabo-reasoning.mjs",
    "pabo:rich": "node scripts/test-pabo-rich.mjs",
    "meetkunde:check": "node scripts/test-meetkunde.mjs",
    "release:plan": "node scripts/classify-release-change.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:full": "node scripts/release-prepare.mjs --full",
    "flirt:replace": "node scripts/replace-flirt.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "type": "module"
}
